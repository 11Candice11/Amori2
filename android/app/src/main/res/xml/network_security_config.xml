<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cleartext (HTTP) is disabled by default on Android 9+.
        We permit it only for specific hosts:
          - The Amori EC2 backend (temporary; will move to HTTPS + domain later)
          - localhost / 10.0.2.2 for the Metro dev server and local backend testing
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">51.20.141.199</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.51</domain>
    </domain-config>
</network-security-config>
