<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Push Notifications (aps-environment) is intentionally NOT enabled here.
         A free/personal Apple development team cannot provision the Push
         Notifications capability, so including it breaks signing for local
         device builds. Push is already a no-op in the app until APNs
         credentials and a paid-team entitlement are set up. To re-enable:
           <key>aps-environment</key><string>development</string>
         and build with a paid Apple Developer team. -->
  </dict>
</plist>
